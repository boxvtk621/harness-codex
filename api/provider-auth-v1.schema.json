{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h1-cloud.ru/schemas/harness-provider-auth-v1.schema.json",
  "title": "Harness provider authentication v1",
  "oneOf": [
    { "$ref": "#/$defs/envelope" },
    { "$ref": "#/$defs/startRequest" },
    { "$ref": "#/$defs/commandRequest" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nullableText": { "type": ["string", "null"] },
    "reasonCode": {
      "enum": [null, "cancelled", "credential_rejected", "expired", "interrupted_by_restart", "invalid_secret", "managed_auth_required", "provider_operation_missing", "provider_protocol_error", "provider_unavailable", "verification_failed"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "canCheck", "canLogout"],
      "properties": {
        "methods": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["device_code", "secret"] },
          "minItems": 1,
          "maxItems": 2
        },
        "canCheck": { "type": "boolean" },
        "canLogout": { "type": "boolean" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "commandId", "method", "status", "createdAt", "updatedAt", "reasonCode", "verificationUrl", "userCode", "expiresAt", "timeoutAt"],
      "properties": {
        "operationId": { "$ref": "#/$defs/uuid" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "method": { "enum": ["device_code", "secret"] },
        "status": { "enum": ["pending", "succeeded", "failed", "cancelled", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "reasonCode": { "$ref": "#/$defs/reasonCode" },
        "verificationUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
        "userCode": { "$ref": "#/$defs/nullableText" },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "timeoutAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "nodeId", "revision", "state", "checkedAt", "reasonCode", "capabilities", "operation"],
      "properties": {
        "schemaId": { "const": "harness-provider-auth-v1" },
        "nodeId": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "state": { "enum": ["unknown", "unauthenticated", "authenticated", "reauthentication_required"] },
        "checkedAt": { "type": ["string", "null"], "format": "date-time" },
        "reasonCode": { "$ref": "#/$defs/reasonCode" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "operation": { "oneOf": [{ "$ref": "#/$defs/operation" }, { "type": "null" }] }
      }
    },
    "startRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "commandId", "method"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/uuid" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "method": { "enum": ["device_code", "secret"] },
        "secret": { "type": "string", "minLength": 1 }
      }
    },
    "commandRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "commandId"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/uuid" },
        "commandId": { "$ref": "#/$defs/uuid" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "enum": ["invalid_request", "not_found", "pending_operation", "busy", "id_conflict", "unsupported_method", "invalid_secret", "provider_unavailable"] }
      }
    }
  }
}
