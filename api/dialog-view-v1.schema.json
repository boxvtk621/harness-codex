{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelab.local/schemas/dialog-view-v1.schema.json",
  "title": "Harness dialog view v1",
  "oneOf": [
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/read" }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "dialog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialogId", "version", "createdAt", "lastActivityAt", "state"],
      "properties": {
        "dialogId": { "$ref": "#/$defs/uuid" },
        "version": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "lastActivityAt": { "$ref": "#/$defs/timestamp" },
        "state": { "enum": ["idle", "queued", "cancelled", "dispatching", "active", "completed", "failed", "interrupted", "unknown"] },
        "activeRequestId": { "$ref": "#/$defs/uuid" },
        "activeAttemptId": { "$ref": "#/$defs/uuid" }
      }
    },
    "base": {
      "type": "object",
      "required": ["protocolVersion", "schemaId", "nodeId", "epoch", "lastEventSeq"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "schemaId": { "const": "dialog-view-v1" },
        "nodeId": { "$ref": "#/$defs/uuid" },
        "epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "lastEventSeq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "page": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "schemaId", "nodeId", "epoch", "snapshotStateVersion", "lastEventSeq", "items", "nextCursor", "pageType"],
          "properties": {
            "protocolVersion": { "const": 1 }, "schemaId": { "const": "dialog-view-v1" }, "nodeId": { "$ref": "#/$defs/uuid" },
            "epoch": { "type": "integer", "minimum": 1 }, "snapshotStateVersion": { "type": "integer", "minimum": 0 }, "lastEventSeq": { "type": "integer", "minimum": 0 },
            "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/dialog" } },
            "nextCursor": { "type": ["string", "null"], "maxLength": 4096 }, "pageType": { "const": "dialogs" }
          }
        }
      ]
    },
    "read": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "schemaId", "nodeId", "epoch", "stateVersion", "lastEventSeq", "dialog"],
          "properties": {
            "protocolVersion": { "const": 1 }, "schemaId": { "const": "dialog-view-v1" }, "nodeId": { "$ref": "#/$defs/uuid" },
            "epoch": { "type": "integer", "minimum": 1 }, "stateVersion": { "type": "integer", "minimum": 0 }, "lastEventSeq": { "type": "integer", "minimum": 0 },
            "dialog": { "$ref": "#/$defs/dialog" }
          }
        }
      ]
    }
  }
}
